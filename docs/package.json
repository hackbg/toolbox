{
  "name": "@hackbg/docs",
  "type": "module",
  "main": "docs.ts",
  "bugs": "https://github.com/hackbg/toolbox/issues",
  "version": "1.0.0-rc.1",
  "license": "MIT",
  "homepage": "https://github.com/hackbg/toolbox",
  "repository": {"type": "git", "url": "https://github.com/hackbg/toolbox", "directory": "docs"},
  "description": "Renders nice Markdown documents from Typedoc JSON output.",
  "files": [ "README.md", "*.ts", "*.cli.mjs", "!.todo" ],
  "bin": { "docs": "./docs.cli.mjs" },
  "dependencies": {
    "@hackbg/logs": "workspace:^",
    "case":         "^1.6.3",
    "typedoc":      "0.25.13"
  },
  "scripts": {
    "ubik":    "npm run check && npm run cov && ubik",
    "test":    "ensuite README.md",
    "cov":     "ensuite-cov README.md",
    "check":   "tsc --noEmit",
    "clean":   "ubik clean && rm -rf dist types *.dist.*",
    "release": "pnpm check && ubik release --access public --otp 000000"
  }
}
